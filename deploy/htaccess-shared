# Контур Дома — для обычного хостинга с Apache (reg.ru, Timeweb, Beget и подобные).
# Положите этот файл рядом с index.html под именем  .htaccess
# (api.php создаёт такой же сам, если своего файла ещё нет).

# 1. База с аккаунтами наружу не отдаётся — ни сама, ни служебные файлы SQLite
<IfModule mod_authz_core.c>
  <FilesMatch "^kontur\.sqlite">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^kontur\.sqlite">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 2. Один адрес вместо двух: www.сайт.ру → сайт.ру (иначе поисковик видит два сайта)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 3. Документы клиентов — только через api.php, напрямую нельзя
  RewriteRule ^uploads/ - [R=404,L]

  # 4. Всегда HTTPS (раскомментируйте, когда выпустите сертификат в панели хостинга)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 5. Короткие адреса: /dom-ladoga открывает dom-ladoga.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# 6. Несуществующий адрес — честная ошибка 404 со своей страницей.
#    Раньше любой мусорный адрес отдавал сайт с кодом 200, и поисковик считал это страницей.
ErrorDocument 404 /404.html

# 7. Файл приложения: без этой строки Apache отдаёт манифест неизвестным типом
AddType application/manifest+json .webmanifest

# 8. Страница сайта не кешируется браузером — обновления видны сразу.
#    Картинки, наоборот, кешируются на неделю.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
